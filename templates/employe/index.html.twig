{# =====================================================================
   JavaScript
   ===================================================================== #}
<script nonce="{{ csp_nonce() }}">
document.addEventListener('turbo:load', function () {

  var overlay   = document.getElementById('drawer-overlay');
  var drawerAdd = document.getElementById('drawer-add');
  var drawerEdit = document.getElementById('drawer-edit');
  var activeDrawer = null;

  /* ── Ouvrir / fermer un drawer ─────────────────────────────────── */
  function openDrawer(drawer) {
    if (activeDrawer) closeDrawer(activeDrawer, false);
    activeDrawer = drawer;
    overlay.classList.remove('hidden');
    drawer.getBoundingClientRect(); // force reflow
    drawer.classList.remove('-translate-x-full');
    drawer.classList.add('translate-x-0');
    drawer.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
  }

  function closeDrawer(drawer, resetBody) {
    drawer.classList.add('-translate-x-full');
    drawer.classList.remove('translate-x-0');
    drawer.setAttribute('aria-hidden', 'true');
    if (resetBody !== false) {
      setTimeout(function () { overlay.classList.add('hidden'); }, 300);
      document.body.style.overflow = '';
      activeDrawer = null;
    }
  }

  /* ── Bouton "Nouvel employé" ────────────────────────────────────── */
  var openAddBtn = document.getElementById('open-add-drawer');
  if (openAddBtn) openAddBtn.addEventListener('click', function () { openDrawer(drawerAdd); });

  /* ── Boutons [data-close-drawer] (X et Fermer dans les deux drawers) */
  document.querySelectorAll('[data-close-drawer]').forEach(function (btn) {
    btn.addEventListener('click', function () {
      if (activeDrawer) closeDrawer(activeDrawer);
    });
  });

  /* ── Overlay ────────────────────────────────────────────────────── */
  if (overlay) overlay.addEventListener('click', function () {
    if (activeDrawer) closeDrawer(activeDrawer);
  });

  /* ── Escape ─────────────────────────────────────────────────────── */
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape' && activeDrawer) closeDrawer(activeDrawer);
  });

  /* ── Ouverture du drawer EDIT depuis un bouton externe ──────────── */
  // Chaque bouton "Modifier" de la liste doit avoir ces data-attributes :
  //   data-open-edit-drawer
  //   data-id, data-prenom, data-nom, data-email, data-telephone,
  //   data-date-embauche (YYYY-MM-DD), data-statut,
  //   data-roles (JSON array of role IDs e.g. "[1,3]")
  document.querySelectorAll('[data-open-edit-drawer]').forEach(function (btn) {
    btn.addEventListener('click', function () { populateAndOpenEdit(this.dataset); });
  });

  function populateAndOpenEdit(data) {
    var formEdit  = document.getElementById('form-edit');
    var deleteUrl = data.deleteUrl || '#';
    var editUrl   = data.editUrl   || '#';

    formEdit.action = editUrl;

    document.getElementById('edit-prenom').value       = data.prenom       || '';
    document.getElementById('edit-nom').value          = data.nom          || '';
    document.getElementById('edit-email').value        = data.email        || '';
    document.getElementById('edit-telephone').value    = data.telephone    || '';
    document.getElementById('edit-date-embauche').value = data.dateEmbauche || '';
    document.getElementById('edit-statut').value       = data.statut       || 'actif';
    document.getElementById('edit-password').value     = '';
    document.getElementById('edit-password-confirm').value = '';

    // Avatar
    var name = encodeURIComponent((data.prenom + ' ' + data.nom).trim() || 'Employé');
    var preview = document.getElementById('edit-avatar-preview');
    preview.src = 'https://ui-avatars.com/api/?name=' + name + '&background=6366f1&color=fff&size=80';

    // Cocher les bons rôles
    var activeRoles = [];
    try { activeRoles = JSON.parse(data.roles || '[]'); } catch(e) {}
    document.querySelectorAll('.edit-role-checkbox').forEach(function (cb) {
      cb.checked = activeRoles.indexOf(parseInt(cb.dataset.roleId)) !== -1;
    });

    // Configurer la modale de suppression
    var deleteForm = document.getElementById('form-delete');
    var deleteName = document.getElementById('modal-delete-name');
    if (deleteForm) deleteForm.action = deleteUrl;
    if (deleteName) deleteName.textContent = (data.prenom || '') + ' ' + (data.nom || '');

    openDrawer(drawerEdit);
  }

  /* ── Bouton Supprimer dans le drawer edit ───────────────────────── */
  var editDeleteBtn = document.getElementById('edit-delete-btn');
  if (editDeleteBtn) {
    editDeleteBtn.addEventListener('click', function () {
      closeDrawer(drawerEdit);
      if (window.Modal) window.Modal.open('modal-delete-employe');
    });
  }

  /* ── Aperçu avatar (ADD) ────────────────────────────────────────── */
  var addAvatarInput   = document.getElementById('add-avatar-input');
  var addAvatarPreview = document.getElementById('add-avatar-preview');
  var addPrenom        = document.getElementById('add-prenom');
  var addNom           = document.getElementById('add-nom');

  if (addAvatarInput) {
    addAvatarInput.addEventListener('change', function () {
      var file = this.files[0];
      if (!file) return;
      var reader = new FileReader();
      reader.onload = function (e) { addAvatarPreview.src = e.target.result; };
      reader.readAsDataURL(file);
    });
  }

  function updateAddAvatar() {
    var p = addPrenom ? addPrenom.value.trim() : '';
    var n = addNom    ? addNom.value.trim()    : '';
    var name = encodeURIComponent((p + ' ' + n).trim() || 'Nouvel Employé');
    if (addAvatarPreview && addAvatarInput && !addAvatarInput.files.length) {
      addAvatarPreview.src = 'https://ui-avatars.com/api/?name=' + name + '&background=6366f1&color=fff&size=80';
    }
  }
  if (addPrenom) addPrenom.addEventListener('input', updateAddAvatar);
  if (addNom)    addNom.addEventListener('input', updateAddAvatar);

  /* ── Aperçu avatar (EDIT) ─────────────────────────────────────── */
  var editAvatarInput   = document.getElementById('edit-avatar-input');
  var editAvatarPreview = document.getElementById('edit-avatar-preview');
  var editAvatarDelete  = document.getElementById('edit-avatar-delete');

  if (editAvatarInput) {
    editAvatarInput.addEventListener('change', function () {
      var file = this.files[0];
      if (!file) return;
      var reader = new FileReader();
      reader.onload = function (e) { editAvatarPreview.src = e.target.result; };
      reader.readAsDataURL(file);
    });
  }

  if (editAvatarDelete) {
    editAvatarDelete.addEventListener('click', function () {
      editAvatarInput.value = '';
      var p = document.getElementById('edit-prenom').value.trim();
      var n = document.getElementById('edit-nom').value.trim();
      var name = encodeURIComponent((p + ' ' + n).trim() || 'Employé');
      editAvatarPreview.src = 'https://ui-avatars.com/api/?name=' + name + '&background=6366f1&color=fff&size=80';
    });
  }

  /* ── Toggle visibilité MDP (commun aux deux drawers) ────────────── */
  document.querySelectorAll('[data-toggle-password]').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var input  = document.getElementById(this.dataset.togglePassword);
      var eyeOff = this.querySelector('.eye-off');
      var eyeOn  = this.querySelector('.eye-on');
      if (!input) return;
      var show = input.type === 'password';
      input.type = show ? 'text' : 'password';
      eyeOff.classList.toggle('hidden', show);
      eyeOn.classList.toggle('hidden', !show);
    });
  });

  /* ── Validation MDP — ADD ────────────────────────────────────────── */
  var addPw      = document.getElementById('add-password');
  var addPwConf  = document.getElementById('add-password-confirm');
  var addPwMsg   = document.getElementById('add-pw-mismatch');
  var formAdd    = document.getElementById('form-add');

  function checkAddPw() {
    if (!addPwConf || addPwConf.value.length === 0) { if(addPwMsg) addPwMsg.classList.add('hidden'); return true; }
    var ok = addPw.value === addPwConf.value;
    if (addPwMsg) addPwMsg.classList.toggle('hidden', ok);
    addPwConf.classList.toggle('border-red-500', !ok);
    return ok;
  }
  if (addPwConf) addPwConf.addEventListener('input', checkAddPw);
  if (addPw)     addPw.addEventListener('input', checkAddPw);
  if (formAdd)   formAdd.addEventListener('submit', function (e) { if (!checkAddPw()) { e.preventDefault(); addPwConf.focus(); } });

  /* ── Validation MDP — EDIT (optionnel) ─────────────────────────── */
  var editPw     = document.getElementById('edit-password');
  var editPwConf = document.getElementById('edit-password-confirm');
  var editPwMsg  = document.getElementById('edit-pw-mismatch');
  var formEditEl = document.getElementById('form-edit');

  function checkEditPw() {
    if (!editPw || editPw.value.length === 0) { if(editPwMsg) editPwMsg.classList.add('hidden'); return true; }
    if (!editPwConf || editPwConf.value.length === 0) { if(editPwMsg) editPwMsg.classList.add('hidden'); return true; }
    var ok = editPw.value === editPwConf.value;
    if (editPwMsg) editPwMsg.classList.toggle('hidden', ok);
    editPwConf.classList.toggle('border-red-500', !ok);
    return ok;
  }
  if (editPwConf) editPwConf.addEventListener('input', checkEditPw);
  if (editPw)     editPw.addEventListener('input', checkEditPw);
  if (formEditEl) formEditEl.addEventListener('submit', function (e) { if (!checkEditPw()) { e.preventDefault(); editPwConf.focus(); } });

});
</script>

{% endblock %}
