{% extends 'base.html.twig' %}

{% block title %}Lits — Gestion Patient{% endblock %}

{% block body %}
<div class="min-h-screen bg-gray-50 dark:bg-gray-900 flex flex-col">
  {% include 'inc/header.html.twig' %}

  <main class="pt-16 flex-1">
    <div class="max-w-screen-xl mx-auto px-4 py-10">

      <div class="flex items-center justify-between mb-8">
        <div>
          <h1 class="text-2xl font-bold text-gray-900 dark:text-white">Lits</h1>
          <p class="text-sm text-gray-500 dark:text-gray-400 mt-1">Gestion des lits par chambre</p>
        </div>
        <button type="button" id="open-add-drawer"
          class="inline-flex items-center gap-2 px-4 py-2 bg-primary-600 hover:bg-primary-700 text-white text-sm font-semibold rounded-lg transition-colors focus:outline-none focus:ring-2 focus:ring-primary-500 focus:ring-offset-2 dark:focus:ring-offset-gray-900">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
          </svg>
          Nouveau lit
        </button>
      </div>

      {% if lits is empty %}
      <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-16 flex flex-col items-center justify-center text-center shadow-sm">
        <div class="w-16 h-16 rounded-2xl bg-teal-100 dark:bg-teal-900 flex items-center justify-center mb-4">
          <svg class="w-8 h-8 text-teal-500 dark:text-teal-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"/>
          </svg>
        </div>
        <h3 class="text-base font-semibold text-gray-900 dark:text-white mb-1">Aucun lit</h3>
        <p class="text-sm text-gray-500 dark:text-gray-400 mb-6">
          {% if chambres is empty %}Créez d'abord une chambre avant d'ajouter des lits.
          {% else %}Commencez par créer un lit.{% endif %}
        </p>
        {% if chambres is not empty %}
        <button type="button" id="open-add-drawer-empty"
          class="inline-flex items-center gap-2 px-4 py-2 bg-primary-600 hover:bg-primary-700 text-white text-sm font-semibold rounded-lg transition-colors">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
          </svg>
          Créer un lit
        </button>
        {% else %}
        <a href="{{ path('app_chambre_index') }}"
          class="inline-flex items-center gap-2 px-4 py-2 bg-primary-600 hover:bg-primary-700 text-white text-sm font-semibold rounded-lg transition-colors">
          Gérer les chambres
        </a>
        {% endif %}
      </div>

      {% else %}
      <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 shadow-sm overflow-hidden">
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-900/50">
              <th class="text-left px-5 py-3 text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider">Lit</th>
              <th class="text-left px-5 py-3 text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider">Statut</th>
              <th class="text-left px-5 py-3 text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider">Chambre</th>
              <th class="text-left px-5 py-3 text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider">Étage</th>
              <th class="text-left px-5 py-3 text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider">Réservations</th>
              <th class="px-5 py-3"></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100 dark:divide-gray-700">
            {% for lit in lits %}
            <tr class="hover:bg-gray-50 dark:hover:bg-gray-700/50 transition-colors">

              {# Lit #}
              <td class="px-5 py-4">
                <div class="flex items-center gap-3">
                  <div class="w-8 h-8 rounded-lg bg-teal-100 dark:bg-teal-900 flex items-center justify-center flex-shrink-0">
                    <svg class="w-4 h-4 text-teal-600 dark:text-teal-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"/>
                    </svg>
                  </div>
                  <div>
                    <p class="font-medium text-gray-900 dark:text-white">Lit {{ lit.numeroLit }}</p>
                    {% if lit.description %}<p class="text-xs text-gray-400 dark:text-gray-500 truncate max-w-xs">{{ lit.description }}</p>{% endif %}
                  </div>
                </div>
              </td>

              {# Statut #}
              <td class="px-5 py-4">
                {% if lit.statut == 'disponible' %}
                  <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-green-100 text-green-700 dark:bg-green-900 dark:text-green-300">Disponible</span>
                {% elseif lit.statut == 'occupe' %}
                  <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-red-100 text-red-700 dark:bg-red-900 dark:text-red-300">Occupé</span>
                {% elseif lit.statut == 'maintenance' %}
                  <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-yellow-100 text-yellow-700 dark:bg-yellow-900 dark:text-yellow-300">Maintenance</span>
                {% else %}
                  <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-gray-100 text-gray-600 dark:bg-gray-700 dark:text-gray-300">{{ lit.statut|capitalize }}</span>
                {% endif %}
              </td>

              {# Chambre #}
              <td class="px-5 py-4">
                {% if lit.chambre %}
                  <span class="inline-flex items-center gap-1.5 text-sm text-gray-700 dark:text-gray-300">
                    <span class="w-5 h-5 rounded bg-teal-100 dark:bg-teal-900 text-teal-700 dark:text-teal-300 font-bold flex items-center justify-center text-xs">C</span>
                    {{ lit.chambre.numeroChambre }}
                  </span>
                {% else %}—{% endif %}
              </td>

              {# Étage #}
              <td class="px-5 py-4 text-xs text-gray-600 dark:text-gray-300">
                {% if lit.chambre and lit.chambre.etage %}
                  <span class="inline-flex items-center gap-1.5">
                    <span class="w-5 h-5 rounded bg-orange-100 dark:bg-orange-900 text-orange-600 dark:text-orange-400 font-bold flex items-center justify-center text-xs">{{ lit.chambre.etage.numeroEtage }}</span>
                    {{ lit.chambre.etage.nomEtage ?? ('Étage ' ~ lit.chambre.etage.numeroEtage) }}
                  </span>
                {% else %}—{% endif %}
              </td>

              {# Réservations #}
              <td class="px-5 py-4">
                <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-xs font-medium bg-gray-100 text-gray-700 dark:bg-gray-700 dark:text-gray-300">
                  {{ lit.reservations|length }} réservation{{ lit.reservations|length > 1 ? 's' : '' }}
                </span>
              </td>

              {# Actions #}
              <td class="px-5 py-4 text-right">
                <button type="button"
                  class="open-edit-drawer inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium text-gray-700 dark:text-gray-300 bg-gray-100 dark:bg-gray-700 hover:bg-gray-200 dark:hover:bg-gray-600 rounded-lg transition-colors"
                  data-id="{{ lit.id }}"
                  data-numero="{{ lit.numeroLit }}"
                  data-statut="{{ lit.statut }}"
                  data-chambre="{{ lit.chambre ? lit.chambre.id : '' }}"
                  data-description="{{ lit.description ?? '' }}"
                  data-delete-url="{{ path('app_lit_delete', {id: lit.id}) }}">
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/>
                  </svg>
                  Modifier
                </button>
              </td>

            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
      {% endif %}

    </div>
  </main>

  {% include 'inc/footer.html.twig' %}
</div>

{# ── Overlay ───────────────────────────────────────────────────────── #}
<div id="drawer-overlay"
  class="fixed inset-0 bg-black/40 z-40 hidden transition-opacity duration-300"></div>

{# ── Drawer — Ajouter un lit ───────────────────────────────────────── #}
<aside id="drawer-add"
  class="fixed top-0 left-0 h-full w-full max-w-md bg-white dark:bg-gray-900 shadow-2xl z-50
         transform -translate-x-full transition-transform duration-300 ease-in-out flex flex-col">

  <div class="flex items-center justify-between px-6 py-5 border-b border-gray-200 dark:border-gray-700 flex-shrink-0">
    <div class="flex items-center gap-3">
      <div class="w-8 h-8 rounded-lg bg-teal-100 dark:bg-teal-900 flex items-center justify-center">
        <svg class="w-4 h-4 text-teal-600 dark:text-teal-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
        </svg>
      </div>
      <h2 class="text-base font-semibold text-gray-900 dark:text-white">Nouveau lit</h2>
    </div>
    <button type="button" id="close-add-drawer"
      class="p-1.5 rounded-lg text-gray-400 hover:text-gray-600 dark:hover:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
      </svg>
    </button>
  </div>

  <form method="POST" action="{{ path('app_lit_new') }}" class="flex-1 overflow-y-auto px-6 py-6 flex flex-col gap-5">

    <div>
      <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5" for="add-numeroLit">
        Numéro de lit <span class="text-red-500">*</span>
      </label>
      <input type="text" id="add-numeroLit" name="numeroLit" required placeholder="A1"
        class="w-full px-3 py-2.5 text-sm rounded-lg border border-gray-300 dark:border-gray-600
               bg-white dark:bg-gray-800 text-gray-900 dark:text-white
               focus:ring-2 focus:ring-primary-500 focus:border-primary-500 outline-none transition"/>
    </div>

    <div class="grid grid-cols-2 gap-4">
      <div>
        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5" for="add-statutLit">
          Statut <span class="text-red-500">*</span>
        </label>
        <select id="add-statutLit" name="statut" required
          class="w-full px-3 py-2.5 text-sm rounded-lg border border-gray-300 dark:border-gray-600
                 bg-white dark:bg-gray-800 text-gray-900 dark:text-white
                 focus:ring-2 focus:ring-primary-500 focus:border-primary-500 outline-none transition">
          <option value="disponible">Disponible</option>
          <option value="occupe">Occupé</option>
          <option value="maintenance">Maintenance</option>
        </select>
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5" for="add-chambreLit">
          Chambre <span class="text-red-500">*</span>
        </label>
        <select id="add-chambreLit" name="chambre" required
          class="w-full px-3 py-2.5 text-sm rounded-lg border border-gray-300 dark:border-gray-600
                 bg-white dark:bg-gray-800 text-gray-900 dark:text-white
                 focus:ring-2 focus:ring-primary-500 focus:border-primary-500 outline-none transition">
          <option value="">-- Choisir --</option>
          {% for chambre in chambres %}
            <option value="{{ chambre.id }}">
              Ch. {{ chambre.numeroChambre }}{% if chambre.etage %} — {{ chambre.etage.nomEtage ?? ('Ét. ' ~ chambre.etage.numeroEtage) }}{% endif %}
            </option>
          {% endfor %}
        </select>
      </div>
    </div>

    <div>
      <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5" for="add-descriptionLit">
        Description
      </label>
      <textarea id="add-descriptionLit" name="description" rows="3"
        placeholder="Informations complémentaires…"
        class="w-full px-3 py-2.5 text-sm rounded-lg border border-gray-300 dark:border-gray-600
               bg-white dark:bg-gray-800 text-gray-900 dark:text-white
               focus:ring-2 focus:ring-primary-500 focus:border-primary-500 outline-none transition resize-none"></textarea>
    </div>

    <div class="mt-auto pt-4 border-t border-gray-200 dark:border-gray-700 flex gap-3">
      <button type="submit"
        class="flex-1 px-4 py-2.5 bg-primary-600 hover:bg-primary-700 text-white text-sm font-semibold rounded-lg transition-colors focus:outline-none focus:ring-2 focus:ring-primary-500 focus:ring-offset-2 dark:focus:ring-offset-gray-900">
        Créer le lit
      </button>
      <button type="button" id="cancel-add-drawer"
        class="px-4 py-2.5 text-sm font-medium text-gray-700 dark:text-gray-300 bg-gray-100 dark:bg-gray-800 hover:bg-gray-200 dark:hover:bg-gray-700 rounded-lg transition-colors">
        Annuler
      </button>
    </div>

  </form>
</aside>

{# ── Drawer — Modifier un lit ──────────────────────────────────────── #}
<aside id="drawer-edit"
  class="fixed top-0 left-0 h-full w-full max-w-md bg-white dark:bg-gray-900 shadow-2xl z-50
         transform -translate-x-full transition-transform duration-300 ease-in-out flex flex-col">

  <div class="flex items-center justify-between px-6 py-5 border-b border-gray-200 dark:border-gray-700 flex-shrink-0">
    <div class="flex items-center gap-3">
      <div class="w-8 h-8 rounded-lg bg-yellow-100 dark:bg-yellow-900 flex items-center justify-center">
        <svg class="w-4 h-4 text-yellow-600 dark:text-yellow-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/>
        </svg>
      </div>
      <h2 class="text-base font-semibold text-gray-900 dark:text-white">Modifier le lit</h2>
    </div>
    <button type="button" id="close-edit-drawer"
      class="p-1.5 rounded-lg text-gray-400 hover:text-gray-600 dark:hover:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
      </svg>
    </button>
  </div>

  <form id="form-edit-lit" method="POST" action="" class="flex-1 overflow-y-auto px-6 py-6 flex flex-col gap-5">

    <div>
      <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5" for="edit-numeroLit">
        Numéro de lit <span class="text-red-500">*</span>
      </label>
      <input type="text" id="edit-numeroLit" name="numeroLit" required
        class="w-full px-3 py-2.5 text-sm rounded-lg border border-gray-300 dark:border-gray-600
               bg-white dark:bg-gray-800 text-gray-900 dark:text-white
               focus:ring-2 focus:ring-primary-500 focus:border-primary-500 outline-none transition"/>
    </div>

    <div class="grid grid-cols-2 gap-4">
      <div>
        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5" for="edit-statutLit">
          Statut <span class="text-red-500">*</span>
        </label>
        <select id="edit-statutLit" name="statut" required
          class="w-full px-3 py-2.5 text-sm rounded-lg border border-gray-300 dark:border-gray-600
                 bg-white dark:bg-gray-800 text-gray-900 dark:text-white
                 focus:ring-2 focus:ring-primary-500 focus:border-primary-500 outline-none transition">
          <option value="disponible">Disponible</option>
          <option value="occupe">Occupé</option>
          <option value="maintenance">Maintenance</option>
        </select>
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5" for="edit-chambreLit">
          Chambre <span class="text-red-500">*</span>
        </label>
        <select id="edit-chambreLit" name="chambre" required
          class="w-full px-3 py-2.5 text-sm rounded-lg border border-gray-300 dark:border-gray-600
                 bg-white dark:bg-gray-800 text-gray-900 dark:text-white
                 focus:ring-2 focus:ring-primary-500 focus:border-primary-500 outline-none transition">
          {% for chambre in chambres %}
            <option value="{{ chambre.id }}">
              Ch. {{ chambre.numeroChambre }}{% if chambre.etage %} — {{ chambre.etage.nomEtage ?? ('Ét. ' ~ chambre.etage.numeroEtage) }}{% endif %}
            </option>
          {% endfor %}
        </select>
      </div>
    </div>

    <div>
      <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5" for="edit-descriptionLit">
        Description
      </label>
      <textarea id="edit-descriptionLit" name="description" rows="3"
        class="w-full px-3 py-2.5 text-sm rounded-lg border border-gray-300 dark:border-gray-600
               bg-white dark:bg-gray-800 text-gray-900 dark:text-white
               focus:ring-2 focus:ring-primary-500 focus:border-primary-500 outline-none transition resize-none"></textarea>
    </div>

    <div class="mt-auto pt-4 border-t border-gray-200 dark:border-gray-700 flex gap-3">
      <button type="submit"
        class="flex-1 px-4 py-2.5 bg-primary-600 hover:bg-primary-700 text-white text-sm font-semibold rounded-lg transition-colors focus:outline-none focus:ring-2 focus:ring-primary-500 focus:ring-offset-2 dark:focus:ring-offset-gray-900">
        Enregistrer
      </button>
      <button type="button" id="open-delete-modal"
        class="px-4 py-2.5 text-sm font-medium text-red-600 dark:text-red-400 border border-red-300 dark:border-red-700 hover:bg-red-50 dark:hover:bg-red-900/30 rounded-lg transition-colors">
        Supprimer
      </button>
      <button type="button" id="cancel-edit-drawer"
        class="px-4 py-2.5 text-sm font-medium text-gray-700 dark:text-gray-300 bg-gray-100 dark:bg-gray-800 hover:bg-gray-200 dark:hover:bg-gray-700 rounded-lg transition-colors">
        Annuler
      </button>
    </div>

  </form>
</aside>

{# ── Modal confirmation suppression ───────────────────────────────── #}
{% include 'inc/modal_confirm_delete.html.twig' with {
  modal_id:      'modal-delete-lit',
  modal_title:   'Supprimer le lit',
  modal_message: 'Cette action est irréversible. Les réservations associées à ce lit seront également supprimées.',
  form_id:       'form-delete-lit',
  form_action:   '',
} %}

{# ── Flash modals ──────────────────────────────────────────────────── #}
{% if app.flashes('success_lit') is not empty %}
  {% include 'inc/modal_success.html.twig' with {
    modal_title:   'Opération réussie',
    modal_message: app.flashes('success_lit')|first,
    auto_open:     true,
  } %}
{% endif %}
{% if app.flashes('success_lit_edit') is not empty %}
  {% include 'inc/modal_success.html.twig' with {
    modal_title:   'Lit modifié',
    modal_message: app.flashes('success_lit_edit')|first,
    auto_open:     true,
  } %}
{% endif %}

{# ── JS drawers ────────────────────────────────────────────────────── #}
<script nonce="{{ csp_nonce() }}">
document.addEventListener('turbo:load', function () {
  if (!document.getElementById('drawer-add')) return;

  var overlay    = document.getElementById('drawer-overlay');
  var drawerAdd  = document.getElementById('drawer-add');
  var drawerEdit = document.getElementById('drawer-edit');

  function openDrawer(drawer) {
    overlay.classList.remove('hidden');
    drawer.classList.remove('-translate-x-full');
  }
  function closeAll() {
    overlay.classList.add('hidden');
    drawerAdd.classList.add('-translate-x-full');
    drawerEdit.classList.add('-translate-x-full');
  }

  // Ouvrir ajout
  var btnAdd = document.getElementById('open-add-drawer');
  if (btnAdd) btnAdd.addEventListener('click', function () { openDrawer(drawerAdd); });
  var btnAddEmpty = document.getElementById('open-add-drawer-empty');
  if (btnAddEmpty) btnAddEmpty.addEventListener('click', function () { openDrawer(drawerAdd); });

  // Fermer ajout
  document.getElementById('close-add-drawer').addEventListener('click', closeAll);
  document.getElementById('cancel-add-drawer').addEventListener('click', closeAll);

  // Fermer édition
  document.getElementById('close-edit-drawer').addEventListener('click', closeAll);
  document.getElementById('cancel-edit-drawer').addEventListener('click', closeAll);

  // Overlay
  overlay.addEventListener('click', closeAll);

  // Ouvrir édition — remplir les champs
  document.querySelectorAll('.open-edit-drawer').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var id          = this.dataset.id;
      var numero      = this.dataset.numero;
      var statut      = this.dataset.statut;
      var chambreId   = this.dataset.chambre;
      var description = this.dataset.description;
      var deleteUrl   = this.dataset.deleteUrl;

      document.getElementById('form-edit-lit').action = '/lits/' + id + '/edit';
      document.getElementById('edit-numeroLit').value = numero;
      document.getElementById('edit-descriptionLit').value = description;

      // Statut
      var selStatut = document.getElementById('edit-statutLit');
      for (var i = 0; i < selStatut.options.length; i++) {
        selStatut.options[i].selected = (selStatut.options[i].value === statut);
      }

      // Chambre
      var selChambre = document.getElementById('edit-chambreLit');
      for (var j = 0; j < selChambre.options.length; j++) {
        selChambre.options[j].selected = (selChambre.options[j].value === chambreId);
      }

      // Supprimer
      document.getElementById('open-delete-modal').onclick = function () {
        var formDel = document.getElementById('form-delete-lit');
        formDel.action = deleteUrl;
        window.Modal && window.Modal.open('modal-delete-lit');
      };

      openDrawer(drawerEdit);
    });
  });
});
</script>
{% endblock %}
