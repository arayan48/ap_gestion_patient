      {# Placeholder — contenu à venir #}
      <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-16 flex flex-col items-center justify-center text-center shadow-sm">
        <div class="w-16 h-16 rounded-2xl bg-orange-100 dark:bg-orange-900 flex items-center justify-center mb-4">
          <svg class="w-8 h-8 text-orange-500 dark:text-orange-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
          </svg>
        </div>
        <p class="text-base font-semibold text-gray-700 dark:text-gray-300 mb-1">Liste des étages</p>
        <p class="text-sm text-gray-400 dark:text-gray-500">Le contenu de cette section est en cours de développement.</p>
      </div>

    </div>
  </main>

  {% include 'inc/footer.html.twig' %}
</div>
{% endblock %}
