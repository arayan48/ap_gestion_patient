{# =====================================================================
   Variables Twig
   ===================================================================== #}
{% set currentRoute = app.request.attributes.get('_route') %}

{% if app.user %}
  {% set userPrenom   = app.user.prenom %}
  {% set userNom      = app.user.nom %}
  {% set userEmail    = app.user.email %}
  {% set userInitials = app.user.prenom|first|upper ~ app.user.nom|first|upper %}

  {# Affiche le premier rôle métier (hors ROLE_USER) #}
  {% set displayRole = 'Employé' %}
  {% for role in app.user.roles %}
    {% if role != 'ROLE_USER' and displayRole == 'Employé' %}
      {% set displayRole = role|replace({'ROLE_': ''})|lower|capitalize %}
    {% endif %}
  {% endfor %}
{% else %}
  {% set userPrenom   = 'Invité' %}
  {% set userNom      = '' %}
  {% set userEmail    = '' %}
  {% set userInitials = '?' %}
  {% set displayRole  = '' %}
{% endif %}

{# Macro : classe d'un lien de navigation (actif ou non) #}
{% macro navClass(routeName, currentRoute) %}
  flex items-center gap-2 px-3 py-2 text-sm rounded-lg transition-colors
  {%- if currentRoute == routeName %}
    bg-primary-50 text-primary-700 font-semibold dark:bg-gray-700 dark:text-white
  {%- else %}
    text-gray-700 hover:bg-primary-50 hover:text-primary-700 dark:text-gray-300 dark:hover:bg-gray-700 dark:hover:text-white
  {%- endif %}
{% endmacro %}
{% import _self as nav %}

{# =====================================================================
   BARRE DE NAVIGATION
   ===================================================================== #}
<nav class="bg-white border-b border-gray-200 dark:bg-gray-900 dark:border-gray-700 fixed w-full z-30 top-0 left-0">
  <div class="max-w-screen-xl flex items-center justify-between mx-auto px-4 py-2.5 gap-4">

    {# ── Brand ─────────────────────────────────────────────────────── #}
    <a href="{{ path('app_home') }}" class="flex items-center gap-2.5 flex-shrink-0">
      <div class="w-8 h-8 rounded-lg bg-primary-600 flex items-center justify-center">
        <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
            d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5
               M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
        </svg>
      </div>
      <span class="text-lg font-bold text-gray-900 dark:text-white whitespace-nowrap hidden sm:block">
        Gestion Patient
      </span>
    </a>

{% if app.user %}
    {# ── Nav desktop (ordre 1) — utilisateur connecté ──────────────── #}
    <div id="mobile-menu"
         class="hidden w-full md:flex md:w-auto md:order-1 absolute md:static top-full left-0 right-0
                bg-white dark:bg-gray-900 border-b border-gray-200 dark:border-gray-700 md:border-0
                px-4 pb-4 md:p-0 shadow-md md:shadow-none z-20">
      <ul class="flex flex-col md:flex-row md:items-center md:space-x-0.5 gap-0.5 mt-3 md:mt-0">

        {# ── Tableau de bord — tous ── #}
        <li>
          <a href="{{ path('app_home') }}" class="{{ nav.navClass('app_home', currentRoute) }}" aria-current="{{ currentRoute == 'app_home' ? 'page' : 'false' }}">
            <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3
                   m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
            </svg>
            Tableau de bord
          </a>
        </li>

        {# ── Patients — tous ── #}
        <li>
          <a href="{{ path('app_patient_index') }}" class="{{ nav.navClass('app_patient_index', currentRoute) }}" aria-current="{{ currentRoute starts with 'app_patient' ? 'page' : 'false' }}">
            <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857
                   M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857
                   m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
            Patients
          </a>
        </li>

        {# ── Réservations — tous ── #}
        <li>
          <a href="{{ path('app_reservation_index') }}" class="{{ nav.navClass('app_reservation_index', currentRoute) }}" aria-current="{{ currentRoute starts with 'app_reservation' ? 'page' : 'false' }}">
            <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
            </svg>
            Réservations
          </a>
        </li>

        {# ── Section admin — séparateur visuel ── #}
        {% if is_granted('ROLE_ADMINISTRATEUR') %}
        <li class="hidden md:block" aria-hidden="true">
          <div class="w-px h-5 bg-gray-200 dark:bg-gray-700 mx-1"></div>
        </li>

        {# ── Chambres — admin ── #}
        <li>
          <a href="{{ path('app_chambre_index') }}" class="{{ nav.navClass('app_chambre_index', currentRoute) }}" aria-current="{{ currentRoute starts with 'app_chambre' ? 'page' : 'false' }}">
            <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5
                   M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
            </svg>
            Chambres
          </a>
        </li>

        {# ── Étages — admin ── #}
        <li>
          <a href="{{ path('app_etage_index') }}" class="{{ nav.navClass('app_etage_index', currentRoute) }}" aria-current="{{ currentRoute starts with 'app_etage' ? 'page' : 'false' }}">
            <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2
                   m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
            </svg>
            Étages
          </a>
        </li>

        {# ── Employés — admin ── #}
        <li>
          <a href="{{ path('app_employe_index') }}" class="{{ nav.navClass('app_employe_index', currentRoute) }}" aria-current="{{ currentRoute starts with 'app_employe' ? 'page' : 'false' }}">
            <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm-9 8a3 3 0 100-6 3 3 0 000 6z"/>
            </svg>
            Employés
          </a>
        </li>

        {# ── Rôles — admin ── #}
        <li>
          <a href="{{ path('app_role_index') }}" class="{{ nav.navClass('app_role_index', currentRoute) }}" aria-current="{{ currentRoute starts with 'app_role' ? 'page' : 'false' }}">
            <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
            </svg>
            Rôles
          </a>
        </li>
        {% endif %}

      </ul>
    </div>

    {# ── Contrôles droite (ordre 2) ────────────────────────────────── #}
    <div class="flex items-center gap-1 md:order-2 flex-shrink-0">

      {# — Recherche — #}
      <div class="relative flex items-center">
        <button id="search-toggle" type="button"
          aria-label="Ouvrir la recherche"
          aria-expanded="false"
          class="p-2 text-gray-500 rounded-lg hover:bg-gray-100 dark:text-gray-400 dark:hover:bg-gray-700 transition-colors focus:outline-none">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
          </svg>
        </button>

        <div id="search-box"
             class="hidden absolute right-0 top-full mt-2 w-72 bg-white dark:bg-gray-800 rounded-xl
                    shadow-lg border border-gray-200 dark:border-gray-700 p-2 z-50">
          <div class="flex items-center gap-2 px-3 py-2 bg-gray-50 dark:bg-gray-700 rounded-lg">
            <svg class="w-4 h-4 text-gray-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
            </svg>
            <input id="search-input" type="text" placeholder="Rechercher… (Ctrl+K)"
              class="flex-1 bg-transparent text-sm text-gray-900 dark:text-white placeholder-gray-400
                     focus:outline-none border-none outline-none"/>
            <kbd class="hidden sm:inline-flex items-center px-1.5 py-0.5 text-xs font-medium text-gray-500
                        dark:text-gray-400 bg-gray-200 dark:bg-gray-600 rounded">Esc</kbd>
          </div>
          <p class="text-xs text-gray-400 dark:text-gray-500 mt-2 px-1">
            Tapez pour rechercher des patients, chambres…
          </p>
        </div>
      </div>

      {# — Mode sombre — #}
      <button id="dark-toggle" type="button"
        aria-label="Basculer le mode sombre"
        class="p-2 text-gray-500 rounded-lg hover:bg-gray-100 dark:text-gray-400 dark:hover:bg-gray-700 transition-colors focus:outline-none">
        {# Lune (mode clair actif) #}
        <svg id="dark-icon-moon" class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
          <path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"/>
        </svg>
        {# Soleil (mode sombre actif) #}
        <svg id="dark-icon-sun" class="w-5 h-5 hidden" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd"
            d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z"
            clip-rule="evenodd"/>
        </svg>
      </button>

      {# — Notifications — #}
      <div class="relative">
        <button id="notif-btn" type="button"
          aria-label="Notifications"
          aria-expanded="false"
          class="relative p-2 text-gray-500 rounded-lg hover:bg-gray-100 dark:text-gray-400 dark:hover:bg-gray-700 transition-colors focus:outline-none">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/>
          </svg>
          {# Badge (nombre non lu — mettre 0 pour masquer) #}
          <span id="notif-badge"
            class="absolute top-1 right-1 inline-flex items-center justify-center w-4 h-4 text-xs font-bold
                   text-white bg-red-500 rounded-full ring-2 ring-white dark:ring-gray-900">
            3
          </span>
        </button>

        <div id="notif-dropdown"
             class="hidden absolute right-0 mt-2 w-80 bg-white dark:bg-gray-800 rounded-xl shadow-lg
                    border border-gray-200 dark:border-gray-700 z-50 overflow-hidden">
          <div class="flex items-center justify-between px-4 py-3 border-b border-gray-100 dark:border-gray-700">
            <h3 class="text-sm font-semibold text-gray-900 dark:text-white">Notifications</h3>
            <button id="notif-mark-all-read" type="button"
              class="text-xs text-primary-600 hover:text-primary-700 dark:text-primary-400 font-medium focus:outline-none">
              Tout marquer comme lu
            </button>
          </div>
          <ul class="divide-y divide-gray-100 dark:divide-gray-700 max-h-72 overflow-y-auto">
            <li class="flex items-start gap-3 px-4 py-3 hover:bg-gray-50 dark:hover:bg-gray-700 cursor-pointer">
              <div class="flex-shrink-0 w-8 h-8 rounded-full bg-blue-100 dark:bg-blue-900 flex items-center justify-center mt-0.5">
                <svg class="w-4 h-4 text-blue-600 dark:text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                    d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"/>
                </svg>
              </div>
              <div class="flex-1 min-w-0">
                <p class="text-sm font-medium text-gray-900 dark:text-white">Nouveau patient admis</p>
                <p class="text-xs text-gray-500 dark:text-gray-400 mt-0.5">Chambre 204 · il y a 10 min</p>
              </div>
              <span class="flex-shrink-0 w-2 h-2 bg-blue-500 rounded-full mt-2"></span>
            </li>
            <li class="flex items-start gap-3 px-4 py-3 hover:bg-gray-50 dark:hover:bg-gray-700 cursor-pointer">
              <div class="flex-shrink-0 w-8 h-8 rounded-full bg-yellow-100 dark:bg-yellow-900 flex items-center justify-center mt-0.5">
                <svg class="w-4 h-4 text-yellow-600 dark:text-yellow-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                    d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L3.732 16.5c-.77.833.192 2.5 1.732 2.5z"/>
                </svg>
              </div>
              <div class="flex-1 min-w-0">
                <p class="text-sm font-medium text-gray-900 dark:text-white">Réservation expirée</p>
                <p class="text-xs text-gray-500 dark:text-gray-400 mt-0.5">Lit 12B · il y a 1 h</p>
              </div>
              <span class="flex-shrink-0 w-2 h-2 bg-blue-500 rounded-full mt-2"></span>
            </li>
            <li class="flex items-start gap-3 px-4 py-3 hover:bg-gray-50 dark:hover:bg-gray-700 cursor-pointer">
              <div class="flex-shrink-0 w-8 h-8 rounded-full bg-green-100 dark:bg-green-900 flex items-center justify-center mt-0.5">
                <svg class="w-4 h-4 text-green-600 dark:text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                    d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
              </div>
              <div class="flex-1 min-w-0">
                <p class="text-sm font-medium text-gray-900 dark:text-white">Sortie confirmée</p>
                <p class="text-xs text-gray-500 dark:text-gray-400 mt-0.5">Patient Martin · il y a 3 h</p>
              </div>
              <span class="flex-shrink-0 w-2 h-2 bg-blue-500 rounded-full mt-2"></span>
            </li>
          </ul>
          <div class="px-4 py-3 border-t border-gray-100 dark:border-gray-700 text-center">
            <a href="#" class="text-sm text-primary-600 hover:text-primary-700 dark:text-primary-400 font-medium">
              Voir toutes les notifications
            </a>
          </div>
        </div>
      </div>

      {# — Menu utilisateur — #}
      <div class="relative">
        <button id="user-menu-btn" type="button"
          aria-label="Menu utilisateur"
          aria-expanded="false"
          aria-haspopup="true"
          class="flex items-center gap-2 pl-1 pr-2 py-1 rounded-full hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors focus:outline-none focus:ring-2 focus:ring-primary-300 dark:focus:ring-primary-700">

          {# Avatar avec initiales #}
          <div class="w-8 h-8 rounded-full bg-primary-600 flex items-center justify-center flex-shrink-0 text-white text-sm font-bold select-none">
            {{ userInitials }}
          </div>
          <span class="hidden lg:block text-sm font-medium text-gray-700 dark:text-gray-300 whitespace-nowrap max-w-28 truncate">
            {{ userPrenom }}
          </span>
          <svg class="w-3.5 h-3.5 text-gray-400 flex-shrink-0 hidden lg:block" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
          </svg>
        </button>

        {# Dropdown utilisateur (caché par défaut) #}
        <div id="user-menu-dropdown"
             class="hidden absolute right-0 mt-2 w-56 bg-white dark:bg-gray-800 rounded-xl shadow-lg
                    border border-gray-200 dark:border-gray-700 divide-y divide-gray-100 dark:divide-gray-700 z-50">

          {# Infos utilisateur #}
          <div class="px-4 py-3 flex items-center gap-3">
            <div class="w-10 h-10 rounded-full bg-primary-600 flex items-center justify-center flex-shrink-0 text-white font-bold">
              {{ userInitials }}
            </div>
            <div class="min-w-0">
              <p class="text-sm font-semibold text-gray-900 dark:text-white truncate">
                {{ userPrenom }} {{ userNom }}
              </p>
              <p class="text-xs text-gray-500 dark:text-gray-400 truncate">{{ userEmail }}</p>
              {% if displayRole %}
                <span class="inline-block mt-0.5 text-xs font-medium px-1.5 py-0.5 rounded bg-primary-100 text-primary-700 dark:bg-primary-900 dark:text-primary-300">
                  {{ displayRole }}
                </span>
              {% endif %}
            </div>
          </div>

          {# Actions #}
          <ul class="py-1">
            <li>
              <a href="#" class="flex items-center gap-2.5 px-4 py-2 text-sm text-gray-700 hover:bg-gray-50 dark:text-gray-200 dark:hover:bg-gray-700 transition-colors">
                <svg class="w-4 h-4 text-gray-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                    d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                </svg>
                Mon profil
              </a>
            </li>
            <li>
              <a href="#" class="flex items-center gap-2.5 px-4 py-2 text-sm text-gray-700 hover:bg-gray-50 dark:text-gray-200 dark:hover:bg-gray-700 transition-colors">
                <svg class="w-4 h-4 text-gray-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                    d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
                Paramètres
              </a>
            </li>
          </ul>

          {# Déconnexion #}
          <ul class="py-1">
            <li>
              <a href="{{ path('app_logout') }}" class="flex items-center gap-2.5 px-4 py-2 text-sm text-red-600 hover:bg-red-50 dark:text-red-400 dark:hover:bg-gray-700 transition-colors">
                <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                    d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
                </svg>
                Déconnexion
              </a>
            </li>
          </ul>
        </div>
      </div>

      {# — Hamburger mobile — #}
      <button id="hamburger-btn" type="button"
        aria-label="Ouvrir le menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="inline-flex items-center justify-center p-2 w-10 h-10 text-gray-500 rounded-lg md:hidden
               hover:bg-gray-100 dark:text-gray-400 dark:hover:bg-gray-700
               focus:outline-none focus:ring-2 focus:ring-gray-200 dark:focus:ring-gray-600 transition-colors">
        {# Icône hamburger #}
        <svg id="hamburger-icon" class="w-5 h-5" fill="none" viewBox="0 0 17 14">
          <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
            d="M1 1h15M1 7h15M1 13h15"/>
        </svg>
        {# Icône fermer (×) #}
        <svg id="close-icon" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>

    </div>{# fin contrôles droite (auth) #}

{% else %}
    {# ── Contrôles non-connecté ────────────────────────────────────── #}
    <div class="flex items-center gap-2 flex-shrink-0">

      {# — Mode sombre — #}
      <button id="dark-toggle" type="button"
        aria-label="Basculer le mode sombre"
        class="p-2 text-gray-500 rounded-lg hover:bg-gray-100 dark:text-gray-400 dark:hover:bg-gray-700 transition-colors focus:outline-none">
        <svg id="dark-icon-moon" class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
          <path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"/>
        </svg>
        <svg id="dark-icon-sun" class="w-5 h-5 hidden" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd"
            d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z"
            clip-rule="evenodd"/>
        </svg>
      </button>

      {# — Bouton Se connecter — #}
      <a href="{{ path('app_login') }}"
        class="inline-flex items-center gap-2 px-4 py-2 text-sm font-semibold rounded-lg
               bg-primary-600 text-white hover:bg-primary-700 active:bg-primary-800
               transition-colors focus:outline-none focus:ring-2 focus:ring-primary-500 focus:ring-offset-2
               dark:focus:ring-offset-gray-900">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
            d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"/>
        </svg>
        Se connecter
      </a>

    </div>{# fin contrôles non-connecté #}
{% endif %}

  </div>
