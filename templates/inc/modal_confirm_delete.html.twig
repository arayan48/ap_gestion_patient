{#
  =====================================================================
  MODAL — Confirmation de suppression
  =====================================================================
  Usage :
    {% include 'inc/modal_confirm_delete.html.twig' with {
        modal_id    : 'deletePatient',
        message     : 'Êtes-vous sûr de vouloir supprimer ce patient ?',
        form_action : path('app_patient_delete', { id: patient.id }),
        csrf_token  : csrf_token('delete-patient-' ~ patient.id)
    } %}

  Puis pour ouvrir la modal depuis un bouton dans la page :
    <button type="button" data-open-modal="deletePatient">Supprimer</button>

  Paramètres disponibles :
    modal_id    (string)  — identifiant unique de la modal    [requis]
    message     (string)  — texte de confirmation             [optionnel]
    form_action (string)  — action du formulaire DELETE        [requis]
    csrf_token  (string)  — token CSRF Symfony                 [optionnel]
    btn_confirm (string)  — label bouton confirmer             [optionnel]
    btn_cancel  (string)  — label bouton annuler               [optionnel]
  =====================================================================
#}

{% set _modal_id    = modal_id    ?? 'confirmDeleteModal' %}
{% set _message     = message     ?? 'Êtes-vous sûr de vouloir supprimer cet élément ? Cette action est irréversible.' %}
{% set _btn_confirm = btn_confirm ?? 'Oui, supprimer' %}
{% set _btn_cancel  = btn_cancel  ?? 'Annuler' %}

{# Overlay + Modal #}
<div id="{{ _modal_id }}"
     role="dialog"
     aria-modal="true"
     aria-labelledby="{{ _modal_id }}-title"
     aria-hidden="true"
     tabindex="-1"
     class="modal-overlay hidden fixed inset-0 z-50 flex items-center justify-center
            bg-gray-900/50 dark:bg-gray-900/70 backdrop-blur-sm p-4">

  <div class="modal-box relative w-full max-w-md bg-white dark:bg-gray-800 rounded-xl shadow-xl
               border border-gray-200 dark:border-gray-700 p-6 text-center"
       role="document">

    {# Bouton fermer #}
    <button type="button"
            data-close-modal="{{ _modal_id }}"
            aria-label="Fermer"
            class="absolute top-3 right-3 text-gray-400 hover:text-gray-600 dark:hover:text-gray-300
                   hover:bg-gray-100 dark:hover:bg-gray-700 rounded-lg p-1.5 transition-colors focus:outline-none">
      <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
        <path fill-rule="evenodd"
          d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414
             L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0
             01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z"
          clip-rule="evenodd"/>
      </svg>
    </button>

    {# Icône poubelle #}
    <div class="w-12 h-12 rounded-full bg-red-100 dark:bg-red-900/40 flex items-center justify-center mx-auto mb-4">
      <svg class="w-6 h-6 text-red-600 dark:text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
          d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6
             m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
      </svg>
    </div>

    <h3 id="{{ _modal_id }}-title" class="text-lg font-semibold text-gray-900 dark:text-white mb-2">
      Confirmer la suppression
    </h3>
    <p class="text-sm text-gray-500 dark:text-gray-400 mb-6">
      {{ _message }}
    </p>

    {# Formulaire DELETE (méthode Symfony : POST + _method=DELETE) #}
    <form method="POST" action="{{ form_action ?? '#' }}">
      {% if csrf_token is defined %}
        <input type="hidden" name="_token" value="{{ csrf_token }}">
      {% endif %}
      <input type="hidden" name="_method" value="DELETE">

      <div class="flex justify-center items-center gap-3">
        <button type="button"
                data-close-modal="{{ _modal_id }}"
                class="px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300
                       rounded-lg hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-gray-300
                       dark:bg-gray-700 dark:text-gray-300 dark:border-gray-500
                       dark:hover:bg-gray-600 dark:hover:text-white dark:focus:ring-gray-600 transition-colors">
          {{ _btn_cancel }}
        </button>

        <button type="submit"
                class="px-4 py-2 text-sm font-medium text-white bg-red-600 rounded-lg
                       hover:bg-red-700 focus:outline-none focus:ring-4 focus:ring-red-300
                       dark:bg-red-500 dark:hover:bg-red-600 dark:focus:ring-red-900 transition-colors">
          <svg class="w-4 h-4 inline mr-1 -mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6
                 m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
          </svg>
          {{ _btn_confirm }}
        </button>
      </div>
    </form>

  </div>
</div>
