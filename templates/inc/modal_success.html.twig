{#
  =====================================================================
  MODAL — Message de succès
  =====================================================================
  Usage :
    {% include 'inc/modal_success.html.twig' with {
        modal_id     : 'successPatient',
        title        : 'Patient ajouté',
        message      : 'Le patient a été enregistré avec succès.',
        redirect_url : path('app_patient_index'),
        auto_open    : true
    } %}

  Ou déclencher manuellement depuis un bouton :
    <button type="button" data-open-modal="successPatient">Voir</button>

  Paramètres disponibles :
    modal_id     (string)  — identifiant unique de la modal    [requis]
    title        (string)  — titre affiché                     [optionnel]
    message      (string)  — message de succès                 [optionnel]
    redirect_url (string)  — URL du bouton "Continuer"         [optionnel]
    btn_label    (string)  — label bouton principal            [optionnel]
    auto_open    (bool)    — ouvrir automatiquement au chargement [optionnel, défaut: false]
  =====================================================================
#}

{% set _modal_id     = modal_id     ?? 'successModal' %}
{% set _title        = title        ?? 'Opération réussie' %}
{% set _message      = message      ?? 'L\'opération a été effectuée avec succès.' %}
{% set _redirect_url = redirect_url ?? null %}
{% set _btn_label    = btn_label    ?? 'Continuer' %}
{% set _auto_open    = auto_open    ?? false %}

<div id="{{ _modal_id }}"
     role="dialog"
     aria-modal="true"
     aria-labelledby="{{ _modal_id }}-title"
     aria-hidden="true"
     tabindex="-1"
     class="modal-overlay hidden fixed inset-0 z-50 flex items-center justify-center
            bg-gray-900/50 dark:bg-gray-900/70 backdrop-blur-sm p-4">

  <div class="modal-box relative w-full max-w-md bg-white dark:bg-gray-800 rounded-xl shadow-xl
               border border-gray-200 dark:border-gray-700 p-6 text-center"
       role="document">

    {# Bouton fermer #}
    <button type="button"
            data-close-modal="{{ _modal_id }}"
            aria-label="Fermer"
            class="absolute top-3 right-3 text-gray-400 hover:text-gray-600 dark:hover:text-gray-300
                   hover:bg-gray-100 dark:hover:bg-gray-700 rounded-lg p-1.5 transition-colors focus:outline-none">
      <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
        <path fill-rule="evenodd"
          d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414
             L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0
             01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z"
          clip-rule="evenodd"/>
      </svg>
    </button>

    {# Icône succès #}
    <div class="w-14 h-14 rounded-full bg-green-100 dark:bg-green-900/40 flex items-center justify-center mx-auto mb-4">
      <svg class="w-8 h-8 text-green-500 dark:text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
      </svg>
    </div>

    <h3 id="{{ _modal_id }}-title" class="text-lg font-bold text-gray-900 dark:text-white mb-2">
      {{ _title }}
    </h3>
    <p class="text-sm text-gray-500 dark:text-gray-400 mb-6">
      {{ _message }}
    </p>

    <div class="flex justify-center gap-3">
      {# Bouton principal : redirige ou ferme #}
      {% if _redirect_url %}
        <a href="{{ _redirect_url }}"
           class="px-5 py-2 text-sm font-medium text-white bg-primary-600 rounded-lg
                  hover:bg-primary-700 focus:outline-none focus:ring-4 focus:ring-primary-300
                  dark:bg-primary-500 dark:hover:bg-primary-600 dark:focus:ring-primary-800 transition-colors">
          {{ _btn_label }}
        </a>
      {% else %}
        <button type="button"
                data-close-modal="{{ _modal_id }}"
                class="px-5 py-2 text-sm font-medium text-white bg-primary-600 rounded-lg
                       hover:bg-primary-700 focus:outline-none focus:ring-4 focus:ring-primary-300
                       dark:bg-primary-500 dark:hover:bg-primary-600 dark:focus:ring-primary-800 transition-colors">
          {{ _btn_label }}
        </button>
      {% endif %}
    </div>

  </div>
</div>

{# Ouverture automatique si auto_open est vrai (ex: après un flash Symfony) #}
{% if _auto_open %}
<script>
document.addEventListener('turbo:load', function () {
  if (window.Modal) { window.Modal.open('{{ _modal_id }}'); }
});
</script>
{% endif %}
