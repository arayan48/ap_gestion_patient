{% extends 'base.html.twig' %}

{% block title %}Paramètres — Gestion Patient{% endblock %}

{% block body %}
<div class="min-h-screen bg-gray-50 dark:bg-gray-900 flex flex-col">
  {% include 'inc/header.html.twig' %}

  <main class="pt-16 flex-1">
    <div class="max-w-screen-xl mx-auto px-4 py-10">

      {# ── En-tête ──────────────────────────────────────────────────────── #}
      <div class="mb-8 flex items-center gap-3">
        <div class="flex-shrink-0 w-10 h-10 rounded-lg bg-primary-100 dark:bg-primary-900 flex items-center justify-center">
          <svg class="w-5 h-5 text-primary-600 dark:text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
          </svg>
        </div>
        <div>
          <h1 class="text-2xl font-bold text-gray-900 dark:text-white">Paramètres</h1>
          <p class="text-sm text-gray-500 dark:text-gray-400 mt-0.5">Vue d'ensemble du système et journal d'audit</p>
        </div>
      </div>

      {# ── Stats globales ────────────────────────────────────────────────── #}
      <h2 class="text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider mb-4">
        Statistiques globales
      </h2>
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-4 mb-10">

        <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-4 text-center shadow-sm">
          <div class="w-9 h-9 rounded-lg bg-primary-100 dark:bg-primary-900 flex items-center justify-center mx-auto mb-2">
            <svg class="w-5 h-5 text-primary-600 dark:text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
          </div>
          <p class="text-2xl font-bold text-gray-900 dark:text-white">{{ stats.patients }}</p>
          <p class="text-xs text-gray-500 dark:text-gray-400 mt-0.5">Patients</p>
        </div>

        <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-4 text-center shadow-sm">
          <div class="w-9 h-9 rounded-lg bg-green-100 dark:bg-green-900 flex items-center justify-center mx-auto mb-2">
            <svg class="w-5 h-5 text-green-600 dark:text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
            </svg>
          </div>
          <p class="text-2xl font-bold text-gray-900 dark:text-white">{{ stats.chambres }}</p>
          <p class="text-xs text-gray-500 dark:text-gray-400 mt-0.5">Chambres</p>
        </div>

        <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-4 text-center shadow-sm">
          <div class="w-9 h-9 rounded-lg bg-teal-100 dark:bg-teal-900 flex items-center justify-center mx-auto mb-2">
            <svg class="w-5 h-5 text-teal-600 dark:text-teal-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"/>
            </svg>
          </div>
          <p class="text-2xl font-bold text-gray-900 dark:text-white">{{ stats.lits }}</p>
          <p class="text-xs text-gray-500 dark:text-gray-400 mt-0.5">Lits</p>
        </div>

        <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-4 text-center shadow-sm">
          <div class="w-9 h-9 rounded-lg bg-yellow-100 dark:bg-yellow-900 flex items-center justify-center mx-auto mb-2">
            <svg class="w-5 h-5 text-yellow-600 dark:text-yellow-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
            </svg>
          </div>
          <p class="text-2xl font-bold text-gray-900 dark:text-white">{{ stats.reservations }}</p>
          <p class="text-xs text-gray-500 dark:text-gray-400 mt-0.5">Réservations</p>
        </div>

        <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-4 text-center shadow-sm">
          <div class="w-9 h-9 rounded-lg bg-purple-100 dark:bg-purple-900 flex items-center justify-center mx-auto mb-2">
            <svg class="w-5 h-5 text-purple-600 dark:text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
            </svg>
          </div>
          <p class="text-2xl font-bold text-gray-900 dark:text-white">{{ stats.employes }}</p>
          <p class="text-xs text-gray-500 dark:text-gray-400 mt-0.5">Employés</p>
        </div>

        <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-4 text-center shadow-sm">
          <div class="w-9 h-9 rounded-lg bg-gray-100 dark:bg-gray-700 flex items-center justify-center mx-auto mb-2">
            <svg class="w-5 h-5 text-gray-500 dark:text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
            </svg>
          </div>
          <p class="text-2xl font-bold text-gray-900 dark:text-white">{{ stats.logs }}</p>
          <p class="text-xs text-gray-500 dark:text-gray-400 mt-0.5">Entrées log</p>
        </div>

      </div>

      {# ── Réservations par statut ───────────────────────────────────────── #}
      <h2 class="text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider mb-4">
        Répartition des réservations
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-10">

        <div class="bg-white dark:bg-gray-800 rounded-xl border border-blue-200 dark:border-blue-800 p-4 flex items-center gap-4 shadow-sm">
          <div class="w-10 h-10 rounded-lg bg-blue-100 dark:bg-blue-900 flex items-center justify-center flex-shrink-0">
            <svg class="w-5 h-5 text-blue-600 dark:text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
          </div>
          <div>
            <p class="text-2xl font-bold text-gray-900 dark:text-white">{{ statsReservations.en_cours }}</p>
            <p class="text-sm text-gray-500 dark:text-gray-400">En cours</p>
          </div>
        </div>

        <div class="bg-white dark:bg-gray-800 rounded-xl border border-green-200 dark:border-green-800 p-4 flex items-center gap-4 shadow-sm">
          <div class="w-10 h-10 rounded-lg bg-green-100 dark:bg-green-900 flex items-center justify-center flex-shrink-0">
            <svg class="w-5 h-5 text-green-600 dark:text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
          </div>
          <div>
            <p class="text-2xl font-bold text-gray-900 dark:text-white">{{ statsReservations.terminee }}</p>
            <p class="text-sm text-gray-500 dark:text-gray-400">Terminées</p>
          </div>
        </div>

        <div class="bg-white dark:bg-gray-800 rounded-xl border border-red-200 dark:border-red-800 p-4 flex items-center gap-4 shadow-sm">
          <div class="w-10 h-10 rounded-lg bg-red-100 dark:bg-red-900 flex items-center justify-center flex-shrink-0">
            <svg class="w-5 h-5 text-red-600 dark:text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
          </div>
          <div>
            <p class="text-2xl font-bold text-gray-900 dark:text-white">{{ statsReservations.annulee }}</p>
            <p class="text-sm text-gray-500 dark:text-gray-400">Annulées</p>
          </div>
        </div>

      </div>

      {# ── Journal d'audit ───────────────────────────────────────────────── #}
      <div class="flex items-center justify-between mb-4">
        <h2 class="text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider">
          Journal d'audit
          <span class="ml-2 px-2 py-0.5 rounded-full text-xs font-bold bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-300">
            {{ total }} entrée{{ total > 1 ? 's' : '' }}
          </span>
        </h2>
        {% if pages > 1 %}
        <p class="text-xs text-gray-400">Page {{ page }} / {{ pages }}</p>
        {% endif %}
      </div>

      <div class="bg-white dark:bg-gray-800 rounded-2xl border border-gray-200 dark:border-gray-700 shadow-sm overflow-hidden mb-6">

        {% if logs is empty %}
        <div class="px-6 py-12 flex flex-col items-center text-center">
          <svg class="w-10 h-10 text-gray-300 dark:text-gray-600 mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
          </svg>
          <p class="text-sm text-gray-400 dark:text-gray-500">Aucune entrée dans le journal d'audit.</p>
        </div>

        {% else %}
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead>
              <tr class="border-b border-gray-100 dark:border-gray-700 bg-gray-50 dark:bg-gray-900">
                <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider whitespace-nowrap">Date</th>
                <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider whitespace-nowrap">Employé</th>
                <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider">Action</th>
                <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider">Table</th>
                <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider">ID objet</th>
                <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider">Détail</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-100 dark:divide-gray-700">
              {% for log in logs %}
              <tr class="hover:bg-gray-50 dark:hover:bg-gray-750 transition-colors">

                {# Date #}
                <td class="px-4 py-3 whitespace-nowrap text-xs text-gray-500 dark:text-gray-400">
                  {{ log.dateAction|date('d/m/Y') }}<br>
                  <span class="text-gray-400 dark:text-gray-500">{{ log.dateAction|date('H:i:s') }}</span>
                </td>

                {# Employé #}
                <td class="px-4 py-3 whitespace-nowrap">
                  {% if log.employe %}
                    <span class="font-medium text-gray-900 dark:text-white">
                      {{ log.employe.prenom }} {{ log.employe.nom }}
                    </span>
                  {% else %}
                    <span class="text-gray-400 dark:text-gray-500 italic">Système</span>
                  {% endif %}
                </td>

                {# Action #}
                <td class="px-4 py-3 whitespace-nowrap">
                  {% set actionLower = log.action|lower %}
                  {% if 'creat' in actionLower or 'ajout' in actionLower or 'insert' in actionLower %}
                    <span class="inline-flex items-center px-2 py-0.5 rounded-md text-xs font-semibold bg-green-100 text-green-700 dark:bg-green-900 dark:text-green-300">
                      {{ log.action }}
                    </span>
                  {% elseif 'updat' in actionLower or 'modif' in actionLower or 'edit' in actionLower %}
                    <span class="inline-flex items-center px-2 py-0.5 rounded-md text-xs font-semibold bg-blue-100 text-blue-700 dark:bg-blue-900 dark:text-blue-300">
                      {{ log.action }}
                    </span>
                  {% elseif 'delet' in actionLower or 'supprim' in actionLower %}
                    <span class="inline-flex items-center px-2 py-0.5 rounded-md text-xs font-semibold bg-red-100 text-red-700 dark:bg-red-900 dark:text-red-300">
                      {{ log.action }}
                    </span>
                  {% else %}
                    <span class="inline-flex items-center px-2 py-0.5 rounded-md text-xs font-semibold bg-gray-100 text-gray-600 dark:bg-gray-700 dark:text-gray-300">
                      {{ log.action }}
                    </span>
                  {% endif %}
                </td>

                {# Table #}
                <td class="px-4 py-3 whitespace-nowrap">
                  <span class="inline-flex items-center px-2 py-0.5 rounded-md text-xs font-medium bg-primary-50 text-primary-700 dark:bg-primary-900/40 dark:text-primary-300 border border-primary-200 dark:border-primary-700">
                    {{ log.tableConcernee }}
                  </span>
                </td>

                {# ID objet #}
                <td class="px-4 py-3 whitespace-nowrap text-sm text-gray-500 dark:text-gray-400">
                  {{ log.idObjet ?? '—' }}
                </td>

                {# Détail (ancien/nouvel état) #}
                <td class="px-4 py-3 text-xs text-gray-500 dark:text-gray-400 max-w-xs">
                  {% if log.ancienEtat or log.nouvelEtat %}
                  <button type="button"
                    onclick="this.nextElementSibling.classList.toggle('hidden')"
                    class="text-primary-600 dark:text-primary-400 hover:underline text-xs">
                    Voir le détail
                  </button>
                  <div class="hidden mt-1 space-y-1">
                    {% if log.ancienEtat %}
                    <div>
                      <span class="font-medium text-red-500">Avant :</span>
                      <code class="block text-xs bg-gray-100 dark:bg-gray-700 rounded p-1 mt-0.5 break-all whitespace-pre-wrap max-w-xs overflow-auto max-h-24">{{ log.ancienEtat }}</code>
                    </div>
                    {% endif %}
                    {% if log.nouvelEtat %}
                    <div>
                      <span class="font-medium text-green-500">Après :</span>
                      <code class="block text-xs bg-gray-100 dark:bg-gray-700 rounded p-1 mt-0.5 break-all whitespace-pre-wrap max-w-xs overflow-auto max-h-24">{{ log.nouvelEtat }}</code>
                    </div>
                    {% endif %}
                  </div>
                  {% else %}
                    <span class="text-gray-300 dark:text-gray-600">—</span>
                  {% endif %}
                </td>

              </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>

        {% endif %}
      </div>

      {# ── Pagination ────────────────────────────────────────────────────── #}
      {% if pages > 1 %}
      <nav class="flex items-center justify-center gap-1">
        {% if page > 1 %}
        <a href="{{ path('app_parametres', {page: page - 1}) }}"
          class="px-3 py-1.5 text-sm rounded-lg border border-gray-200 dark:border-gray-700
                 text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors">
          ← Précédent
        </a>
        {% endif %}

        {% for p in 1..pages %}
          {% if p == page %}
          <span class="px-3 py-1.5 text-sm rounded-lg bg-primary-600 text-white font-semibold">{{ p }}</span>
          {% elseif p == 1 or p == pages or (p >= page - 2 and p <= page + 2) %}
          <a href="{{ path('app_parametres', {page: p}) }}"
            class="px-3 py-1.5 text-sm rounded-lg border border-gray-200 dark:border-gray-700
                   text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors">
            {{ p }}
          </a>
          {% elseif p == page - 3 or p == page + 3 %}
          <span class="px-2 text-gray-400">…</span>
          {% endif %}
        {% endfor %}

        {% if page < pages %}
        <a href="{{ path('app_parametres', {page: page + 1}) }}"
          class="px-3 py-1.5 text-sm rounded-lg border border-gray-200 dark:border-gray-700
                 text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors">
          Suivant →
        </a>
        {% endif %}
      </nav>
      {% endif %}

    </div>
  </main>

  {% include 'inc/footer.html.twig' %}
</div>
{% endblock %}
