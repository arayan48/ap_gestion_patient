{% extends 'base.html.twig' %}

{% block title %}Mon profil — Gestion Patient{% endblock %}

{% block body %}
<div class="min-h-screen bg-gray-50 dark:bg-gray-900 flex flex-col">
  {% include 'inc/header.html.twig' %}

  <main class="pt-16 flex-1">
    <div class="max-w-3xl mx-auto px-4 py-10">

      {# ── En-tête ──────────────────────────────────────────────────────── #}
      <div class="mb-8 flex items-center gap-4">
        <div class="w-16 h-16 rounded-2xl bg-primary-600 flex items-center justify-center flex-shrink-0 shadow">
          <span class="text-2xl font-bold text-white select-none">
            {{ app.user.prenom|first|upper }}{{ app.user.nom|first|upper }}
          </span>
        </div>
        <div>
          <h1 class="text-2xl font-bold text-gray-900 dark:text-white">Mon profil</h1>
          <p class="text-sm text-gray-500 dark:text-gray-400 mt-0.5">
            Gérez vos informations personnelles et votre mot de passe
          </p>
        </div>
      </div>

      {# ── Flash messages ───────────────────────────────────────────────── #}
      {% for msg in app.flashes('success_profil') %}
      <div class="mb-6 flex items-center gap-3 px-4 py-3 rounded-xl bg-green-50 dark:bg-green-900/30 border border-green-200 dark:border-green-700 text-green-800 dark:text-green-300 text-sm font-medium">
        <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
        {{ msg }}
      </div>
      {% endfor %}

      {% for msg in app.flashes('error_profil') %}
      <div class="mb-6 flex items-center gap-3 px-4 py-3 rounded-xl bg-red-50 dark:bg-red-900/30 border border-red-200 dark:border-red-700 text-red-800 dark:text-red-300 text-sm font-medium">
        <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
        {{ msg }}
      </div>
      {% endfor %}

      {% for msg in app.flashes('error_password') %}
      <div class="mb-6 flex items-center gap-3 px-4 py-3 rounded-xl bg-red-50 dark:bg-red-900/30 border border-red-200 dark:border-red-700 text-red-800 dark:text-red-300 text-sm font-medium">
        <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
        {{ msg }}
      </div>
      {% endfor %}

      {# ── Carte : Informations personnelles ────────────────────────────── #}
      <div class="bg-white dark:bg-gray-800 rounded-2xl border border-gray-200 dark:border-gray-700 shadow-sm mb-6">
        <div class="px-6 py-4 border-b border-gray-100 dark:border-gray-700 flex items-center gap-2">
          <svg class="w-5 h-5 text-primary-600 dark:text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
          </svg>
          <h2 class="text-base font-semibold text-gray-900 dark:text-white">Informations personnelles</h2>
        </div>

        <form action="{{ path('app_profil_edit') }}" method="POST" class="px-6 py-6">
          <input type="hidden" name="_token" value="{{ csrf_token('profil-edit') }}">

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">

            {# Prénom #}
            <div>
              <label for="prenom" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5">
                Prénom
              </label>
              <input type="text" id="prenom" name="prenom"
                value="{{ app.user.prenom }}"
                required
                class="w-full px-3 py-2 text-sm rounded-lg border border-gray-300 dark:border-gray-600
                       bg-white dark:bg-gray-700 text-gray-900 dark:text-white
                       focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-primary-500
                       placeholder-gray-400 dark:placeholder-gray-500 transition"/>
            </div>

            {# Nom #}
            <div>
              <label for="nom" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5">
                Nom
              </label>
              <input type="text" id="nom" name="nom"
                value="{{ app.user.nom }}"
                required
                class="w-full px-3 py-2 text-sm rounded-lg border border-gray-300 dark:border-gray-600
                       bg-white dark:bg-gray-700 text-gray-900 dark:text-white
                       focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-primary-500
                       placeholder-gray-400 dark:placeholder-gray-500 transition"/>
            </div>

            {# Email — lecture seule #}
            <div>
              <label class="block text-sm font-medium text-gray-500 dark:text-gray-400 mb-1.5">
                Email <span class="text-xs text-gray-400">(identifiant de connexion)</span>
              </label>
              <div class="px-3 py-2 text-sm rounded-lg border border-gray-200 dark:border-gray-700
                          bg-gray-50 dark:bg-gray-900 text-gray-500 dark:text-gray-400 select-none">
                {{ app.user.email }}
              </div>
            </div>

            {# Téléphone #}
            <div>
              <label for="telephone" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5">
                Téléphone <span class="text-xs text-gray-400">(optionnel)</span>
              </label>
              <input type="tel" id="telephone" name="telephone"
                value="{{ app.user.telephone ?? '' }}"
                placeholder="+33 6 00 00 00 00"
                class="w-full px-3 py-2 text-sm rounded-lg border border-gray-300 dark:border-gray-600
                       bg-white dark:bg-gray-700 text-gray-900 dark:text-white
                       focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-primary-500
                       placeholder-gray-400 dark:placeholder-gray-500 transition"/>
            </div>

          </div>

          {# Champs en lecture seule #}
          <div class="mt-5 grid grid-cols-1 sm:grid-cols-2 gap-5">

            <div>
              <label class="block text-sm font-medium text-gray-500 dark:text-gray-400 mb-1.5">
                Date d'embauche
              </label>
              <div class="px-3 py-2 text-sm rounded-lg border border-gray-200 dark:border-gray-700
                          bg-gray-50 dark:bg-gray-900 text-gray-500 dark:text-gray-400 select-none">
                {{ app.user.dateEmbauche|date('d/m/Y') }}
              </div>
            </div>

            <div>
              <label class="block text-sm font-medium text-gray-500 dark:text-gray-400 mb-1.5">
                Rôles
              </label>
              <div class="px-3 py-2 text-sm rounded-lg border border-gray-200 dark:border-gray-700
                          bg-gray-50 dark:bg-gray-900 text-gray-500 dark:text-gray-400 select-none flex flex-wrap gap-1.5">
                {% set hasRole = false %}
                {% for role in app.user.roles %}
                  {% if role != 'ROLE_USER' %}
                    {% set hasRole = true %}
                    <span class="inline-block px-2 py-0.5 rounded-md text-xs font-medium bg-primary-100 text-primary-700 dark:bg-primary-900 dark:text-primary-300">
                      {{ role|replace({'ROLE_': ''})|lower|capitalize }}
                    </span>
                  {% endif %}
                {% endfor %}
                {% if not hasRole %}
                  <span class="text-gray-400">Employé</span>
                {% endif %}
              </div>
            </div>

          </div>

          <div class="mt-6 flex justify-end">
            <button type="submit"
              class="inline-flex items-center gap-2 px-5 py-2.5 bg-primary-600 hover:bg-primary-700 active:bg-primary-800
                     text-white text-sm font-semibold rounded-xl transition-colors
                     focus:outline-none focus:ring-2 focus:ring-primary-500 focus:ring-offset-2 dark:focus:ring-offset-gray-800">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M5 13l4 4L19 7"/>
              </svg>
              Enregistrer les modifications
            </button>
          </div>

        </form>
      </div>

      {# ── Carte : Changer le mot de passe ──────────────────────────────── #}
      <div class="bg-white dark:bg-gray-800 rounded-2xl border border-gray-200 dark:border-gray-700 shadow-sm">
        <div class="px-6 py-4 border-b border-gray-100 dark:border-gray-700 flex items-center gap-2">
          <svg class="w-5 h-5 text-yellow-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
          </svg>
          <h2 class="text-base font-semibold text-gray-900 dark:text-white">Changer le mot de passe</h2>
        </div>

        <form action="{{ path('app_profil_password') }}" method="POST" class="px-6 py-6">
          <input type="hidden" name="_token" value="{{ csrf_token('profil-password') }}">

          <div class="space-y-4">

            <div>
              <label for="current_password" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5">
                Mot de passe actuel
              </label>
              <input type="password" id="current_password" name="current_password"
                required autocomplete="current-password"
                class="w-full px-3 py-2 text-sm rounded-lg border border-gray-300 dark:border-gray-600
                       bg-white dark:bg-gray-700 text-gray-900 dark:text-white
                       focus:outline-none focus:ring-2 focus:ring-yellow-500 focus:border-yellow-500
                       transition"/>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">

              <div>
                <label for="new_password" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5">
                  Nouveau mot de passe
                </label>
                <input type="password" id="new_password" name="new_password"
                  required autocomplete="new-password" minlength="8"
                  class="w-full px-3 py-2 text-sm rounded-lg border border-gray-300 dark:border-gray-600
                         bg-white dark:bg-gray-700 text-gray-900 dark:text-white
                         focus:outline-none focus:ring-2 focus:ring-yellow-500 focus:border-yellow-500
                         transition"/>
                <p class="mt-1 text-xs text-gray-400">Minimum 8 caractères</p>
              </div>

              <div>
                <label for="confirm_password" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5">
                  Confirmer le nouveau mot de passe
                </label>
                <input type="password" id="confirm_password" name="confirm_password"
                  required autocomplete="new-password"
                  class="w-full px-3 py-2 text-sm rounded-lg border border-gray-300 dark:border-gray-600
                         bg-white dark:bg-gray-700 text-gray-900 dark:text-white
                         focus:outline-none focus:ring-2 focus:ring-yellow-500 focus:border-yellow-500
                         transition"/>
              </div>

            </div>

          </div>

          <div class="mt-6 flex justify-end">
            <button type="submit"
              class="inline-flex items-center gap-2 px-5 py-2.5 bg-yellow-500 hover:bg-yellow-600 active:bg-yellow-700
                     text-white text-sm font-semibold rounded-xl transition-colors
                     focus:outline-none focus:ring-2 focus:ring-yellow-500 focus:ring-offset-2 dark:focus:ring-offset-gray-800">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
              </svg>
              Mettre à jour le mot de passe
            </button>
          </div>

        </form>
      </div>

    </div>
  </main>

  {% include 'inc/footer.html.twig' %}
</div>
{% endblock %}
