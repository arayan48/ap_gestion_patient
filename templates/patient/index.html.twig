{% extends 'base.html.twig' %}

{% block title %}Patients — Gestion Patient{% endblock %}

{% block body %}
<div class="min-h-screen bg-gray-50 dark:bg-gray-900 flex flex-col">
  {% include 'inc/header.html.twig' %}

  <main class="pt-16 flex-1">
    <div class="max-w-screen-xl mx-auto px-4 py-10">

      <div class="flex items-center justify-between mb-8">
        <div>
          <h1 class="text-2xl font-bold text-gray-900 dark:text-white">Patients</h1>
          <p class="text-sm text-gray-500 dark:text-gray-400 mt-1">Gestion des dossiers patients</p>
        </div>
        <button type="button" id="open-add-drawer"
          class="inline-flex items-center gap-2 px-4 py-2 bg-primary-600 hover:bg-primary-700 text-white text-sm font-semibold rounded-lg transition-colors focus:outline-none focus:ring-2 focus:ring-primary-500 focus:ring-offset-2 dark:focus:ring-offset-gray-900">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
          </svg>
          Nouveau patient
        </button>
      </div>

      {% if patients is empty %}
      <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-16 flex flex-col items-center justify-center text-center shadow-sm">
        <div class="w-16 h-16 rounded-2xl bg-blue-100 dark:bg-blue-900 flex items-center justify-center mb-4">
          <svg class="w-8 h-8 text-blue-500 dark:text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>
          </svg>
        </div>
        <h3 class="text-base font-semibold text-gray-900 dark:text-white mb-1">Aucun patient</h3>
        <p class="text-sm text-gray-500 dark:text-gray-400 mb-6">Commencez par enregistrer un patient.</p>
        <button type="button" id="open-add-drawer-empty"
          class="inline-flex items-center gap-2 px-4 py-2 bg-primary-600 hover:bg-primary-700 text-white text-sm font-semibold rounded-lg transition-colors">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
          </svg>
          Ajouter un patient
        </button>
      </div>
      {% else %}
      <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 shadow-sm overflow-hidden">
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-900/50">
              <th class="text-left px-5 py-3 text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider">Patient</th>
              <th class="text-left px-5 py-3 text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider">Date de naissance</th>
              <th class="text-left px-5 py-3 text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider">Sexe</th>
              <th class="text-left px-5 py-3 text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider">Téléphone</th>
              <th class="text-left px-5 py-3 text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider">N° Sécu</th>
              <th class="px-5 py-3"></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100 dark:divide-gray-700">
            {% for patient in patients %}
            <tr class="hover:bg-gray-50 dark:hover:bg-gray-700/50 transition-colors">
              <td class="px-5 py-4">
                <div class="flex items-center gap-3">
                  <div class="w-8 h-8 rounded-full bg-blue-100 dark:bg-blue-900 flex items-center justify-center flex-shrink-0">
                    <span class="text-xs font-semibold text-blue-600 dark:text-blue-400">
                      {{ patient.prenom|first|upper }}{{ patient.nom|first|upper }}
                    </span>
                  </div>
                  <div>
                    <p class="font-medium text-gray-900 dark:text-white">{{ patient.nom }} {{ patient.prenom }}</p>
                    <p class="text-xs text-gray-400 dark:text-gray-500">{{ patient.email ?? '—' }}</p>
                  </div>
                </div>
              </td>
              <td class="px-5 py-4 text-gray-600 dark:text-gray-300">
                {{ patient.dateNaissance|date('d/m/Y') }}
              </td>
              <td class="px-5 py-4">
                {% if patient.sexe == 'M' %}
                  <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-blue-100 text-blue-700 dark:bg-blue-900 dark:text-blue-300">Homme</span>
                {% else %}
                  <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-pink-100 text-pink-700 dark:bg-pink-900 dark:text-pink-300">Femme</span>
                {% endif %}
              </td>
              <td class="px-5 py-4 text-gray-500 dark:text-gray-400">
                {{ patient.telephone ?? '—' }}
              </td>
              <td class="px-5 py-4">
                <code class="text-xs bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-300 px-2 py-1 rounded font-mono">
                  {{ patient.numeroSecuriteSociale }}
                </code>
              </td>
              <td class="px-5 py-4 text-right">
                <button type="button"
                  class="open-edit-drawer inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium text-gray-700 dark:text-gray-300 bg-gray-100 dark:bg-gray-700 hover:bg-gray-200 dark:hover:bg-gray-600 rounded-lg transition-colors"
                  data-id="{{ patient.id }}"
                  data-nom="{{ patient.nom }}"
                  data-prenom="{{ patient.prenom }}"
                  data-sexe="{{ patient.sexe }}"
                  data-date-naissance="{{ patient.dateNaissance|date('Y-m-d') }}"
                  data-adresse="{{ patient.adresse ?? '' }}"
                  data-telephone="{{ patient.telephone ?? '' }}"
                  data-email="{{ patient.email ?? '' }}"
                  data-nss="{{ patient.numeroSecuriteSociale }}"
                  data-delete-url="{{ path('app_patient_delete', {id: patient.id}) }}">
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/>
                  </svg>
                  Modifier
                </button>
              </td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
      {% endif %}

    </div>
  </main>

  {% include 'inc/footer.html.twig' %}
</div>

{# ── Overlay ───────────────────────────────────────────────────────── #}
<div id="drawer-overlay"
  class="fixed inset-0 bg-black/40 z-40 hidden transition-opacity duration-300"></div>

{# ── Drawer — Ajouter un patient ───────────────────────────────────── #}
<aside id="drawer-add"
  class="fixed top-0 left-0 h-full w-full max-w-md bg-white dark:bg-gray-900 shadow-2xl z-50
         transform -translate-x-full transition-transform duration-300 ease-in-out flex flex-col">

  <div class="flex items-center justify-between px-6 py-5 border-b border-gray-200 dark:border-gray-700 flex-shrink-0">
    <div class="flex items-center gap-3">
      <div class="w-8 h-8 rounded-lg bg-blue-100 dark:bg-blue-900 flex items-center justify-center">
        <svg class="w-4 h-4 text-blue-600 dark:text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"/>
        </svg>
      </div>
      <h2 class="text-base font-semibold text-gray-900 dark:text-white">Nouveau patient</h2>
    </div>
    <button type="button" id="close-add-drawer"
      class="p-1.5 rounded-lg text-gray-400 hover:text-gray-600 dark:hover:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
      </svg>
    </button>
  </div>

  <form method="POST" action="{{ path('app_patient_new') }}" class="flex-1 overflow-y-auto px-6 py-6 flex flex-col gap-5">
    <input type="hidden" name="_token" value="{{ csrf_token('patient-new') }}">

    <div class="grid grid-cols-2 gap-4">
      <div>
        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5" for="add-nom">
          Nom <span class="text-red-500">*</span>
        </label>
        <input type="text" id="add-nom" name="nom" required placeholder="Dupont"
          class="w-full px-3 py-2.5 text-sm rounded-lg border border-gray-300 dark:border-gray-600
                 bg-white dark:bg-gray-800 text-gray-900 dark:text-white
                 focus:ring-2 focus:ring-primary-500 focus:border-primary-500 outline-none transition"/>
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5" for="add-prenom">
          Prénom <span class="text-red-500">*</span>
        </label>
        <input type="text" id="add-prenom" name="prenom" required placeholder="Marie"
          class="w-full px-3 py-2.5 text-sm rounded-lg border border-gray-300 dark:border-gray-600
                 bg-white dark:bg-gray-800 text-gray-900 dark:text-white
                 focus:ring-2 focus:ring-primary-500 focus:border-primary-500 outline-none transition"/>
      </div>
    </div>

    <div class="grid grid-cols-2 gap-4">
      <div>
        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5" for="add-dateNaissance">
          Date de naissance <span class="text-red-500">*</span>
        </label>
        <input type="date" id="add-dateNaissance" name="dateNaissance" required
          class="w-full px-3 py-2.5 text-sm rounded-lg border border-gray-300 dark:border-gray-600
                 bg-white dark:bg-gray-800 text-gray-900 dark:text-white
                 focus:ring-2 focus:ring-primary-500 focus:border-primary-500 outline-none transition"/>
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5" for="add-sexe">
          Sexe <span class="text-red-500">*</span>
        </label>
        <select id="add-sexe" name="sexe" required
          class="w-full px-3 py-2.5 text-sm rounded-lg border border-gray-300 dark:border-gray-600
                 bg-white dark:bg-gray-800 text-gray-900 dark:text-white
                 focus:ring-2 focus:ring-primary-500 focus:border-primary-500 outline-none transition">
          <option value="M">Homme</option>
          <option value="F">Femme</option>
        </select>
      </div>
    </div>

    <div>
      <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5" for="add-nss">
        N° Sécurité Sociale <span class="text-red-500">*</span>
      </label>
      <input type="text" id="add-nss" name="numeroSecuriteSociale" required placeholder="1 85 05 75 116 042 28"
        class="w-full px-3 py-2.5 text-sm rounded-lg border border-gray-300 dark:border-gray-600
               bg-white dark:bg-gray-800 text-gray-900 dark:text-white
               focus:ring-2 focus:ring-primary-500 focus:border-primary-500 outline-none transition"/>
    </div>

    <div>
      <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5" for="add-telephone">
        Téléphone
      </label>
      <input type="tel" id="add-telephone" name="telephone" placeholder="06 12 34 56 78"
        class="w-full px-3 py-2.5 text-sm rounded-lg border border-gray-300 dark:border-gray-600
               bg-white dark:bg-gray-800 text-gray-900 dark:text-white
               focus:ring-2 focus:ring-primary-500 focus:border-primary-500 outline-none transition"/>
    </div>

    <div>
      <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5" for="add-email">
        Email
      </label>
      <input type="email" id="add-email" name="email" placeholder="patient@exemple.fr"
        class="w-full px-3 py-2.5 text-sm rounded-lg border border-gray-300 dark:border-gray-600
               bg-white dark:bg-gray-800 text-gray-900 dark:text-white
               focus:ring-2 focus:ring-primary-500 focus:border-primary-500 outline-none transition"/>
    </div>

    <div>
      <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5" for="add-adresse">
        Adresse
      </label>
      <textarea id="add-adresse" name="adresse" rows="2" placeholder="12 rue de la Paix, 75001 Paris"
        class="w-full px-3 py-2.5 text-sm rounded-lg border border-gray-300 dark:border-gray-600
               bg-white dark:bg-gray-800 text-gray-900 dark:text-white
               focus:ring-2 focus:ring-primary-500 focus:border-primary-500 outline-none transition resize-none"></textarea>
    </div>

    <div class="mt-auto pt-4 border-t border-gray-200 dark:border-gray-700 flex gap-3">
      <button type="submit"
        class="flex-1 px-4 py-2.5 bg-primary-600 hover:bg-primary-700 text-white text-sm font-semibold rounded-lg transition-colors focus:outline-none focus:ring-2 focus:ring-primary-500 focus:ring-offset-2 dark:focus:ring-offset-gray-900">
        Enregistrer le patient
      </button>
      <button type="button" id="cancel-add-drawer"
        class="px-4 py-2.5 text-sm font-medium text-gray-700 dark:text-gray-300 bg-gray-100 dark:bg-gray-800 hover:bg-gray-200 dark:hover:bg-gray-700 rounded-lg transition-colors">
        Annuler
      </button>
    </div>

  </form>
</aside>

{# ── Drawer — Modifier un patient ──────────────────────────────────── #}
<aside id="drawer-edit"
  class="fixed top-0 left-0 h-full w-full max-w-md bg-white dark:bg-gray-900 shadow-2xl z-50
         transform -translate-x-full transition-transform duration-300 ease-in-out flex flex-col">

  <div class="flex items-center justify-between px-6 py-5 border-b border-gray-200 dark:border-gray-700 flex-shrink-0">
    <div class="flex items-center gap-3">
      <div class="w-8 h-8 rounded-lg bg-yellow-100 dark:bg-yellow-900 flex items-center justify-center">
        <svg class="w-4 h-4 text-yellow-600 dark:text-yellow-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/>
        </svg>
      </div>
      <h2 class="text-base font-semibold text-gray-900 dark:text-white">Modifier le patient</h2>
    </div>
    <button type="button" id="close-edit-drawer"
      class="p-1.5 rounded-lg text-gray-400 hover:text-gray-600 dark:hover:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
      </svg>
    </button>
  </div>

  <form id="form-edit-patient" method="POST" action="" class="flex-1 overflow-y-auto px-6 py-6 flex flex-col gap-5">
    <input type="hidden" name="_token" value="{{ csrf_token('patient-edit') }}">

    <div class="grid grid-cols-2 gap-4">
      <div>
        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5" for="edit-nom">
          Nom <span class="text-red-500">*</span>
        </label>
        <input type="text" id="edit-nom" name="nom" required
          class="w-full px-3 py-2.5 text-sm rounded-lg border border-gray-300 dark:border-gray-600
                 bg-white dark:bg-gray-800 text-gray-900 dark:text-white
                 focus:ring-2 focus:ring-primary-500 focus:border-primary-500 outline-none transition"/>
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5" for="edit-prenom">
          Prénom <span class="text-red-500">*</span>
        </label>
        <input type="text" id="edit-prenom" name="prenom" required
          class="w-full px-3 py-2.5 text-sm rounded-lg border border-gray-300 dark:border-gray-600
                 bg-white dark:bg-gray-800 text-gray-900 dark:text-white
                 focus:ring-2 focus:ring-primary-500 focus:border-primary-500 outline-none transition"/>
      </div>
    </div>

    <div class="grid grid-cols-2 gap-4">
      <div>
        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5" for="edit-dateNaissance">
          Date de naissance <span class="text-red-500">*</span>
        </label>
        <input type="date" id="edit-dateNaissance" name="dateNaissance" required
          class="w-full px-3 py-2.5 text-sm rounded-lg border border-gray-300 dark:border-gray-600
                 bg-white dark:bg-gray-800 text-gray-900 dark:text-white
                 focus:ring-2 focus:ring-primary-500 focus:border-primary-500 outline-none transition"/>
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5" for="edit-sexe">
          Sexe <span class="text-red-500">*</span>
        </label>
        <select id="edit-sexe" name="sexe" required
          class="w-full px-3 py-2.5 text-sm rounded-lg border border-gray-300 dark:border-gray-600
                 bg-white dark:bg-gray-800 text-gray-900 dark:text-white
                 focus:ring-2 focus:ring-primary-500 focus:border-primary-500 outline-none transition">
          <option value="M">Homme</option>
          <option value="F">Femme</option>
        </select>
      </div>
    </div>

    <div>
      <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5" for="edit-nss">
        N° Sécurité Sociale <span class="text-red-500">*</span>
      </label>
      <input type="text" id="edit-nss" name="numeroSecuriteSociale" required
        class="w-full px-3 py-2.5 text-sm rounded-lg border border-gray-300 dark:border-gray-600
               bg-white dark:bg-gray-800 text-gray-900 dark:text-white
               focus:ring-2 focus:ring-primary-500 focus:border-primary-500 outline-none transition"/>
    </div>

    <div>
      <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5" for="edit-telephone">
        Téléphone
      </label>
      <input type="tel" id="edit-telephone" name="telephone"
        class="w-full px-3 py-2.5 text-sm rounded-lg border border-gray-300 dark:border-gray-600
               bg-white dark:bg-gray-800 text-gray-900 dark:text-white
               focus:ring-2 focus:ring-primary-500 focus:border-primary-500 outline-none transition"/>
    </div>

    <div>
      <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5" for="edit-email">
        Email
      </label>
      <input type="email" id="edit-email" name="email"
        class="w-full px-3 py-2.5 text-sm rounded-lg border border-gray-300 dark:border-gray-600
               bg-white dark:bg-gray-800 text-gray-900 dark:text-white
               focus:ring-2 focus:ring-primary-500 focus:border-primary-500 outline-none transition"/>
    </div>

    <div>
      <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5" for="edit-adresse">
        Adresse
      </label>
      <textarea id="edit-adresse" name="adresse" rows="2"
        class="w-full px-3 py-2.5 text-sm rounded-lg border border-gray-300 dark:border-gray-600
               bg-white dark:bg-gray-800 text-gray-900 dark:text-white
               focus:ring-2 focus:ring-primary-500 focus:border-primary-500 outline-none transition resize-none"></textarea>
    </div>

    <div class="mt-auto pt-4 border-t border-gray-200 dark:border-gray-700 flex gap-3">
      <button type="submit"
        class="flex-1 px-4 py-2.5 bg-primary-600 hover:bg-primary-700 text-white text-sm font-semibold rounded-lg transition-colors focus:outline-none focus:ring-2 focus:ring-primary-500 focus:ring-offset-2 dark:focus:ring-offset-gray-900">
        Enregistrer
      </button>
      <button type="button" id="open-delete-modal"
        class="px-4 py-2.5 text-sm font-medium text-red-600 dark:text-red-400 border border-red-300 dark:border-red-700 hover:bg-red-50 dark:hover:bg-red-900/30 rounded-lg transition-colors">
        Supprimer
      </button>
      <button type="button" id="cancel-edit-drawer"
        class="px-4 py-2.5 text-sm font-medium text-gray-700 dark:text-gray-300 bg-gray-100 dark:bg-gray-800 hover:bg-gray-200 dark:hover:bg-gray-700 rounded-lg transition-colors">
        Annuler
      </button>
    </div>

  </form>
</aside>

{# ── Modal confirmation suppression ───────────────────────────────── #}
{% include 'inc/modal_confirm_delete.html.twig' with {
  modal_id:      'modal-delete-patient',
  modal_title:   'Supprimer le patient',
  modal_message: 'Cette action est irréversible. Toutes les réservations associées à ce patient seront également affectées.',
  form_id:       'form-delete-patient',
  form_action:   '',
  csrf_token:    csrf_token('patient-delete'),
} %}

{# ── Flash modals ──────────────────────────────────────────────────── #}
{% if app.flashes('success_patient') is not empty %}
  {% include 'inc/modal_success.html.twig' with {
    modal_title:   'Opération réussie',
    modal_message: app.flashes('success_patient')|first,
    auto_open:     true,
  } %}
{% endif %}
{% if app.flashes('success_patient_edit') is not empty %}
  {% include 'inc/modal_success.html.twig' with {
    modal_title:   'Patient modifié',
    modal_message: app.flashes('success_patient_edit')|first,
    auto_open:     true,
  } %}
{% endif %}

{# ── JS drawers ────────────────────────────────────────────────────── #}
<script nonce="{{ csp_nonce() }}">
document.addEventListener('turbo:load', function () {
  if (!document.getElementById('drawer-add')) return;

  var overlay    = document.getElementById('drawer-overlay');
  var drawerAdd  = document.getElementById('drawer-add');
  var drawerEdit = document.getElementById('drawer-edit');
  var formEdit   = document.getElementById('form-edit-patient');
  var formDelete = document.getElementById('form-delete-patient');

  function openDrawer(drawer) {
    overlay.classList.remove('hidden');
    requestAnimationFrame(function () {
      drawer.classList.remove('-translate-x-full');
    });
  }

  function closeAll() {
    drawerAdd.classList.add('-translate-x-full');
    drawerEdit.classList.add('-translate-x-full');
    overlay.classList.add('hidden');
  }

  ['open-add-drawer', 'open-add-drawer-empty'].forEach(function (id) {
    var btn = document.getElementById(id);
    if (btn) btn.addEventListener('click', function () { openDrawer(drawerAdd); });
  });

  document.getElementById('close-add-drawer').addEventListener('click', closeAll);
  document.getElementById('cancel-add-drawer').addEventListener('click', closeAll);

  document.querySelectorAll('.open-edit-drawer').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var d = btn.dataset;
      document.getElementById('edit-nom').value           = d.nom;
      document.getElementById('edit-prenom').value        = d.prenom;
      document.getElementById('edit-dateNaissance').value = d.dateNaissance;
      document.getElementById('edit-sexe').value          = d.sexe;
      document.getElementById('edit-nss').value           = d.nss;
      document.getElementById('edit-telephone').value     = d.telephone;
      document.getElementById('edit-email').value         = d.email;
      document.getElementById('edit-adresse').value       = d.adresse;
      formEdit.action = '/patients/' + d.id + '/edit';
      if (formDelete) formDelete.action = d.deleteUrl;
      openDrawer(drawerEdit);
    });
  });

  document.getElementById('close-edit-drawer').addEventListener('click', closeAll);
  document.getElementById('cancel-edit-drawer').addEventListener('click', closeAll);

  var openDeleteBtn = document.getElementById('open-delete-modal');
  if (openDeleteBtn) {
    openDeleteBtn.addEventListener('click', function () {
      closeAll();
      if (window.Modal) window.Modal.open('modal-delete-patient');
    });
  }

  overlay.addEventListener('click', closeAll);
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape') closeAll();
  });
});
</script>

{% endblock %}
